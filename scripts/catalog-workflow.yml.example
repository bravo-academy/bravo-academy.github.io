name: 📚 Build catalog.json
on:
  push:
    branches: [main]
    paths:
      - 'curriculum/**'
      - 'levels/**'
      - 'build_catalog.py'
      - 'assets/**'
  workflow_dispatch:

jobs:
  build-catalog:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Build catalog.json
        run: |
          python3 build_catalog.py
          echo "levels: $(python3 -c 'import json; print(len(json.load(open("catalog.json"))["levels"]))')"

      - name: Commit if changed
        run: |
          if git diff --quiet catalog.json; then
            echo "No changes"
            exit 0
          fi
          git config user.name "bravo-catalog-bot"
          git config user.email "bravo-academy+bot@users.noreply.github.com"
          git add catalog.json
          git commit -m "chore: auto-build catalog.json [skip ci]"
          git push

      - name: Validate catalog
        run: python3 -m json.tool catalog.json > /dev/null && echo "✅ valid"
